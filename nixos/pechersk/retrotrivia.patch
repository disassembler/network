-    main()
+    try:
+        main()
+    finally:
+        # Stop delayed audio callbacks before tearing SDL down.
+        SHUTDOWN.set()
+        for thread in threading.enumerate():
+            if thread is not threading.current_thread():
+                thread.join(timeout=2)
+        # Video decoders must not outlive their game session.
+        children = psutil.Process().children(recursive=True)
+        for child in children:
+            try:
+                child.terminate()
+            except psutil.NoSuchProcess:
+                pass
+        _, pending = psutil.wait_procs(children, timeout=2)
+        for child in pending:
+            try:
+                child.kill()
+            except psutil.NoSuchProcess:
+                pass
+        pygame.quit()
